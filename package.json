{
  "name": "squid-metrics",
  "version": "2.0.0",
  "description": "Biblioteca que coleta métricas (no padrão do Prometheus) do NodeJS, Express e Hapi e as exporta em um server HTTP",
  "type": "module",
  "main": "./dist/squid_metrics.cjs",
  "types": "./dist/squid_metrics.d.ts",
  "exports": {
    ".": {
      "types": "./dist/squid_metrics.d.ts",
      "import": "./dist/squid_metrics.js",
      "require": "./dist/squid_metrics.cjs",
      "default": "./dist/squid_metrics.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "lint": "eslint .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Henrique Martini <henrique.martini@squidit.com.br>",
  "license": "ISC",
  "engines": {
    "node": ">=20",
    "npm": ">=8"
  },
  "dependencies": {
    "@promster/express": "^15.4.6",
    "@promster/hapi": "^15.4.6",
    "@promster/metrics": "^15.4.6",
    "@promster/server": "^15.4.6",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.6",
    "@types/hapi__hapi": "^21.0.0",
    "@types/node": "^25.5.0",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^10.0.3",
    "eslint-plugin-perfectionist": "^5.6.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "globals": "^17.4.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
